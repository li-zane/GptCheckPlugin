# App
# Production requires unique secrets of at least 32 characters and COOKIE_SECURE=true.
APP_NAME="sub2api AT 刷新机"
APP_ENV=development
APP_ADMIN_KEY=replace-with-a-long-random-admin-key
APP_SESSION_SECRET=replace-with-a-long-random-session-secret
APP_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
DISPLAY_TIMEZONE=Asia/Shanghai

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sub2api_at_guardian.db
MAIL_MANAGER_ROUTE_CONFIG_PATH=

# sub2api
SUB2API_BASE_URL=http://localhost:8080/api/v1
SUB2API_AUTH_TOKEN=
SUB2API_AUTH_HEADER=Authorization
SUB2API_AUTH_SCHEME=Bearer
SUB2API_ACCOUNTS_PATH=/admin/accounts
SUB2API_ACCESS_TOKEN_PATH=credentials.access_token
SUB2API_AUTO_CLEAR_ERROR=true
SUB2API_AUTO_RECOVER_STATE=true
SUB2API_SCAN_PORTS=[8080,8081,8000,8001,3000,3001,5000,5001,7860,9000,9001,18080,18081]
SUB2API_SCAN_TIMEOUT_SECONDS=0.8

# Monitor
MONITOR_ENABLED=true
AUTOMATION_PAUSED=false
RECOVERY_ENABLED=false
MONITOR_INTERVAL_SECONDS=300
USAGE_REFRESH_ENABLED=false
USAGE_REFRESH_INTERVAL_SECONDS=3600
USAGE_REFRESH_MAX_CONCURRENCY=5
UPSTREAM_RATE_SYNC_ENABLED=false
UPSTREAM_RATE_LOG_RETENTION_DAYS=90
USAGE_LIMIT_SAMPLE_FIVE_HOUR_THRESHOLD_PERCENT=0
USAGE_LIMIT_SAMPLE_SEVEN_DAY_THRESHOLD_PERCENT=0
USAGE_LIMIT_DEFAULT_RANGES_JSON=
REFRESH_MAX_CONCURRENCY=1
PROTOCOL_REFRESH_MAX_CONCURRENCY=1
BROWSER_REFRESH_MAX_CONCURRENCY=1
BROWSER_MIN_AVAILABLE_MEMORY_MB=500
SUBSCRIPTION_REFRESH_BATCH_SIZE=3
SUBSCRIPTION_REFRESH_MAX_CONCURRENCY=3

# Browser
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_TIMEOUT_MS=90000
CHATGPT_BASE_URL=https://chatgpt.com
CHATGPT_SESSION_URL=https://chatgpt.com/api/auth/session
OPENAI_OAUTH_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
OPENAI_OAUTH_TOKEN_URL=https://auth.openai.com/oauth/token
OPENAI_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_OAUTH_SCOPES=openid profile email offline_access
OPENAI_OAUTH_USER_AGENT=codex_cli_rs/0.104.0
VERIFICATION_CODE_TIMEOUT_SECONDS=180
VERIFICATION_CODE_POLL_SECONDS=6
VERIFICATION_CODE_LOOKUP_GRACE_SECONDS=900

# Outlook / Hotmail Graph mail adapter
GRAPH_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
GRAPH_CONSUMER_TOKEN_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/token
GRAPH_MESSAGES_URL=https://graph.microsoft.com/v1.0/me/mailFolders/inbox/messages
GRAPH_SCOPE=https://graph.microsoft.com/Mail.Read offline_access
OUTLOOK_IMAP_SCOPE=https://outlook.office.com/IMAP.AccessAsUser.All offline_access
OUTLOOK_IMAP_HOST=outlook.office365.com
OUTLOOK_IMAP_HOSTS=["outlook.office365.com","imap-mail.outlook.com"]
OUTLOOK_IMAP_PORT=993
OUTLOOK_IMAP_TIMEOUT_SECONDS=6
OUTLOOK_IMAP_FAILURE_COOLDOWN_SECONDS=30
MAIL_TOKEN_TIMEOUT_SECONDS=10
MAIL_READ_TIMEOUT_SECONDS=45
LIVE_OAUTH_TOKEN_URL=https://login.live.com/oauth20_token.srf
LIVE_OAUTH_SCOPE=wl.offline_access wl.imap
EXTERNAL_MAIL_API_BASE=https://www.appleemail.top
EXTERNAL_MAIL_TIMEOUT_SECONDS=30
