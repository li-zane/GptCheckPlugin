# App
# Production requires unique secrets of at least 32 characters and COOKIE_SECURE=true.
APP_NAME="sub2api AT 刷新机"
APP_ENV=development
APP_ADMIN_KEY=replace-with-a-long-random-admin-key
APP_SESSION_SECRET=replace-with-a-long-random-session-secret
APP_ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
DISPLAY_TIMEZONE=Asia/Shanghai

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sub2api_at_guardian.db
MAIL_MANAGER_ROUTE_CONFIG_PATH=

# sub2api
SUB2API_BASE_URL=http://localhost:8080/api/v1
SUB2API_AUTH_TOKEN=
SUB2API_AUTH_HEADER=Authorization
SUB2API_AUTH_SCHEME=Bearer
SUB2API_ACCOUNTS_PATH=/admin/accounts
SUB2API_ACCESS_TOKEN_PATH=credentials.access_token
SUB2API_AUTO_CLEAR_ERROR=true
SUB2API_AUTO_RECOVER_STATE=true
SUB2API_SCAN_PORTS=[8080,8081,8000,8001,3000,3001,5000,5001,7860,9000,9001,18080,18081]
SUB2API_SCAN_TIMEOUT_SECONDS=0.8

# Monitor
MONITOR_ENABLED=true
